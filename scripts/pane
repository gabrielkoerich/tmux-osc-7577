#!/usr/bin/env bash
# Runs after tmux creates a pane: notes the token tmux copied into it from the global environment, sets a fresh
# one for the next pane, and pipes the pane's output to the reader. tmux has no hook for respawn-pane
set -u
dir=$(cd "$(dirname "$0")" && pwd)
source "$dir/lib.sh"

pane=${1:-}
if [[ ! $pane =~ ^%[0-9]+$ || $dir == *\'* ]]; then
  exit 2
fi

srv=$(server_dir)
file="$srv/tokens/${pane#%}"
# A pane that has a token is not new, as when a grouped session reuses it, so only its pipe is checked
if [[ ! -e $file ]]; then
  lock="$srv/tokens/.lock"
  for _ in $(seq 50); do
    mkdir "$lock" 2>/dev/null && break
    sleep 0.02
  done

  tok=$(tmux show-environment -g OSC7577_TOKEN 2>/dev/null | sed -n 's/^OSC7577_TOKEN=//p')
  # Panes made at the same moment can start with the same token, then neither may use it
  if [[ -n $tok ]] && grep -qxF -- "$tok" "$srv/tokens/.used" 2>/dev/null; then
    grep -lxF -- "$tok" "$srv"/tokens/[0-9]* 2>/dev/null | while IFS= read -r f; do rm -f "$f"; done
    : >"$file"
  elif [[ $tok =~ ^[A-Za-z0-9_-]{22,64}$ ]]; then
    (umask 077 && printf '%s\n' "$tok" >>"$srv/tokens/.used" && printf '%s' "$tok" >"$file")
  fi
  set_token "$(new_token)"
  rmdir "$lock" 2>/dev/null
fi

if [[ ! -s $file ]]; then
  exit 0
fi

# tmux expands % in a pipe-pane command like strftime, so the pane goes as its number
# @osc7577-reader picks the reader: auto, the hub where it builds, or awk, one process a pane
reader=$(option @osc7577-reader auto)
if [[ $reader != awk ]] && bin=$(hub_bin) && sock=$(hub_sock) && [[ $bin != *\'* && $sock != *\'* ]]; then
  if ! hub_alive "$sock"; then
    tmux run-shell -b "'$bin' hub '$sock' '$(tmux display -p '#{pid}')' '$dir/accept' >/dev/null 2>&1"
    # A hub that died closed every pane's pipe, so the panes that have a token get theirs back
    for p in $(tmux list-panes -a -F '#{pane_id}#{?pane_pipe,,-}' | grep -- '-$' | tr -d -); do
      if [[ $p != "$pane" && -s $srv/tokens/${p#%} ]]; then
        tmux pipe-pane -o -O -t "$p" "exec '$bin' pass '$sock' '${p#%}'"
      fi
    done
  fi
  tmux pipe-pane -o -O -t "$pane" "exec '$bin' pass '$sock' '${pane#%}'"
else
  tmux pipe-pane -o -O -t "$pane" "LC_ALL=C exec $(awk_cmd) -v 'RS=[\n\033\007]' -v pane='${pane#%}' -v accept='$dir/accept' -f '$dir/scan.awk'"
fi
