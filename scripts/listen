#!/usr/bin/env bash
# One read-only control client for a session, which receives every pane's output with escapes intact. awk finds
# OSC 7577 reports in it and hands each to accept, so nothing runs until a program sends one
set -u
dir=$(cd "$(dirname "$0")" && pwd)
source "$dir/lib.sh"

sid=${1:-}
if [[ ! $sid =~ ^\$[0-9]+$ || $dir == *\'* ]]; then
  exit 2
fi

lock="$(server_dir)/listeners/${sid#\$}"
if ! mkdir "$lock" 2>/dev/null; then
  if kill -0 "$(cat "$lock/pid" 2>/dev/null)" 2>/dev/null; then
    exit 0
  fi
fi
mkdir -p "$lock"
echo $$ >"$lock/pid"

# A control client runs only what comes on its input and ends when that closes, so it reads a fifo held open and
# never written. Not read-only, since send-keys from anywhere fails when the session's best client is read-only
fifo="$lock/in"
rm -f "$fifo"
mkfifo -m 600 "$fifo"
exec 3<>"$fifo"
trap 'rm -rf "$lock"' EXIT

# tmux writes output as octal escapes, \033 for ESC and \134 for a backslash, so a literal backslash in text
# never looks like an ESC. A report split across two chunks is joined, and one longer than 4096 is dropped
read -r -d '' prog <<'AWK'
/^%output %[0-9]+ / {
  pane = $2
  s = tail[pane] substr($0, length(pane) + 10)
  tail[pane] = ""
  while ((i = index(s, "\\033]7577;")) > 0) {
    rest = substr(s, i + 10)
    a = index(rest, "\\033\\134"); b = index(rest, "\\007")
    if (a && (!b || a < b)) { j = a; n = 8 } else if (b) { j = b; n = 4 } else { j = 0 }
    if (!j) {
      if (length(rest) < 4096) tail[pane] = substr(s, i)
      s = ""
      break
    }
    body = substr(rest, 1, j - 1)
    s = substr(rest, j + n)
    if (length(body) <= 4096 && body ~ /^[A-Za-z0-9_.,+\/=:?-]+$/) {
      system("'" accept "' '" pane "' '" body "' </dev/null")
    }
  }
  if (length(s) > 9) s = substr(s, length(s) - 8)
  if (index(s, "\\")) tail[pane] = s
}
AWK

while tmux has-session -t "$sid" 2>/dev/null; do
  tmux -C attach -t "$sid" -f ignore-size <&3 2>/dev/null | awk -v accept="$dir/accept" "$prog"
  sleep 1
done
