#!/usr/bin/env bash
# tmux copies its global environment into each new pane, so after a pane starts this notes the token it got and
# sets a fresh one for the next pane. Two panes never share a token, as the spec requires
set -u
source "$(dirname "$0")/lib.sh"

case ${1:-} in
  # At load: a fresh token, never one tmux inherited from the terminal it runs in
  (seed) tmux set-environment -g OSC7577_TOKEN "$(new_token)" ;;
  (assign)
    pane=${2:-}
    if [[ ! $pane =~ ^%[0-9]+$ ]]; then
      exit 2
    fi

    tok=$(tmux show-environment -g OSC7577_TOKEN 2>/dev/null | sed -n 's/^OSC7577_TOKEN=//p')
    if [[ $tok =~ ^[A-Za-z0-9_-]{22,64}$ ]]; then
      (umask 077 && printf '%s' "$tok" >"$(server_dir)/tokens/${pane#%}")
    fi
    tmux set-environment -g OSC7577_TOKEN "$(new_token)"
    ;;
  (*) echo "usage: token seed|assign <pane>" >&2; exit 2 ;;
esac
